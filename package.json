{
  "name": "inlay-disguises",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && eslint eslint.config.js scripts",
    "test": "pnpm -r test && node --test \"scripts/__tests__/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-imports": "node scripts/check-imports.mjs",
    "check-words": "node scripts/check-words.mjs --config scripts/check-words.config.json"
  },
  "devDependencies": {
    "eslint": "~9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "~10.1.8",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3"
  }
}
